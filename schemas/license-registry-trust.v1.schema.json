{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/talon23/Dravora-Update-Feed/blob/License-Checker/schemas/license-registry-trust.v1.schema.json",
  "title": "Dravora licence registry trust metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "registry_id", "registry_epoch", "status", "minimum_sequence", "policy", "keys"],
  "properties": {
    "contract": {"const": "dravora-license-registry-trust/v1"},
    "registry_id": {"const": "dravora-production"},
    "registry_epoch": {"const": "63d1c863-c23a-4a8c-9cd0-8e1274a9f423"},
    "status": {"enum": ["unprovisioned", "active"]},
    "minimum_sequence": {"type": "integer", "minimum": 1},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_validity_seconds", "max_future_skew_seconds"],
      "properties": {
        "max_validity_seconds": {"const": 604800},
        "max_future_skew_seconds": {"const": 300}
      }
    },
    "keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "purpose", "algorithm", "public_key_format", "public_key_xml", "public_key_fingerprint", "not_before", "not_after", "status"],
        "properties": {
          "key_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
          "purpose": {"const": "license-status-registry"},
          "algorithm": {"const": "RSASSA-PKCS1-v1_5-SHA256"},
          "public_key_format": {"const": "dotnet-rsa-xml"},
          "public_key_xml": {"type": "string", "pattern": "^<RSAKeyValue><Modulus>[A-Za-z0-9+/]+={0,2}</Modulus><Exponent>[A-Za-z0-9+/]+={0,2}</Exponent></RSAKeyValue>$"},
          "public_key_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "not_before": {"$ref": "#/$defs/timestamp"},
          "not_after": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
          "status": {"enum": ["active", "retired"]}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "unprovisioned"}}},
      "then": {"properties": {"keys": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"const": "active"}}},
      "then": {
        "properties": {
          "keys": {
            "minItems": 1,
            "contains": {
              "type": "object",
              "required": ["status"],
              "properties": {"status": {"const": "active"}}
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}
