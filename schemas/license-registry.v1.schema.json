{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/talon23/Dravora-Update-Feed/blob/License-Checker/schemas/license-registry.v1.schema.json",
  "title": "Dravora licence status registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "registry_id", "registry_epoch", "sequence", "issued_at", "expires_at", "previous_sequence", "previous_payload_sha256", "records"],
  "properties": {
    "contract": {"const": "dravora-license-registry/v1"},
    "registry_id": {"const": "dravora-production"},
    "registry_epoch": {"const": "63d1c863-c23a-4a8c-9cd0-8e1274a9f423"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "previous_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740990},
    "previous_payload_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "records": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["license_ref", "status", "edition", "not_before", "license_expires_at", "status_changed_at", "revision"],
        "properties": {
          "license_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "status": {"enum": ["active", "consumed", "recalled", "expired"]},
          "edition": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"},
          "not_before": {"$ref": "#/$defs/timestamp"},
          "license_expires_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
          "status_changed_at": {"$ref": "#/$defs/timestamp"},
          "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"sequence": {"const": 1}}},
      "then": {
        "properties": {
          "previous_sequence": {"const": 0},
          "previous_payload_sha256": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "previous_sequence": {"minimum": 1},
          "previous_payload_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}
