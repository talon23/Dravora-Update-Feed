{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/talon23/Dravora-Update-Feed/blob/License-Checker/schemas/license-registry-signature.v1.schema.json",
  "title": "Dravora licence registry detached signature v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "registry_path", "registry_epoch", "sequence", "payload_sha256", "algorithm", "key_id", "signature_base64"],
  "properties": {
    "contract": {"const": "dravora-license-registry-signature/v1"},
    "registry_path": {
      "type": "string",
      "pattern": "^license-registry/(registry\\.json|history/[0-9]{16}-[0-9a-f]{64}/registry\\.json)$"
    },
    "registry_epoch": {"const": "63d1c863-c23a-4a8c-9cd0-8e1274a9f423"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "payload_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "algorithm": {"const": "RSASSA-PKCS1-v1_5-SHA256"},
    "key_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "signature_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
  }
}
