{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/talon23/Dravora-Update-Feed/blob/patches/schemas/capability-catalogue.v1.schema.json",
  "title": "Dravora capability catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "packages"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "dravora-capability-catalogue"},
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edition", "predecessorEdition", "moduleSet", "assetName", "assetUri", "sha256", "length"],
        "properties": {
          "edition": {"enum": ["professional", "business"]},
          "predecessorEdition": {"enum": ["standalone", "professional"]},
          "moduleSet": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {"enum": ["professional", "business"]}
          },
          "assetName": {
            "type": "string",
            "pattern": "^Dravora-runtime-[0-9A-Za-z._-]+-(development|test|staging|production)-(developer|test|staging|stable)\\.dravup$"
          },
          "assetUri": {
            "type": "string",
            "pattern": "^https://github\\.com/talon23/Dravora-Update-Feed/releases/download/[^/?#]+/Dravora-runtime-[0-9A-Za-z._-]+-(development|test|staging|production)-(developer|test|staging|stable)\\.dravup$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
          "length": {"type": "integer", "minimum": 1, "maximum": 524288000}
        }
      }
    }
  }
}
